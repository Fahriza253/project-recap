---
import { Image } from 'astro:assets';
import type { ProjectCard } from '../../data/projects';
import { proyekHref } from '../../data/decks';
import PreviewSlider from './PreviewSlider.astro';

interface Props {
  project: ProjectCard;
  index: number;
}

const { project, index } = Astro.props;
const titleId = `judul-${project.id}`;
const heading = `${index + 1} — ${project.name}`;
const deckHref = proyekHref(project.id);
---

<section
  id={project.id}
  class="scroll-mt-[calc(5.5rem+env(safe-area-inset-top,0px))] border-t border-line py-16 md:py-28"
  aria-labelledby={titleId}
  data-reveal
>
  {
    project.layout === 'browser' && (
      <div class="site-gutter mx-auto grid max-w-6xl grid-cols-1 gap-8 md:gap-10 lg:grid-cols-12 lg:items-center">
        <div class="min-w-0 lg:col-span-5">
          <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">{project.kicker}</p>
          <h3 id={titleId} class="mt-4 text-3xl font-semibold tracking-tight break-words md:text-5xl">
            {project.name}
          </h3>
          <p class="mt-5 max-w-md text-base leading-relaxed text-muted">{project.summary}</p>
          <a
            href={deckHref}
            class="mt-8 inline-flex min-h-11 cursor-pointer items-center text-sm font-medium text-lime underline decoration-lime/40 underline-offset-4"
          >
            Buka deck
          </a>
        </div>
        <div class="min-w-0 lg:col-span-7">
          <PreviewSlider slides={project.slides} labelledBy={titleId} frame="browser" />
        </div>
      </div>
    )
  }

  {
    project.layout === 'split' && (
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-0 lg:grid-cols-2">
        <div class="site-gutter py-4 lg:py-0">
          <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">{project.kicker}</p>
          <h3 id={titleId} class="mt-4 text-3xl font-semibold tracking-tight break-words md:text-5xl">
            {project.name}
          </h3>
          <p class="mt-5 max-w-md text-base leading-relaxed text-muted">{project.summary}</p>
          <a
            href={deckHref}
            class="mt-8 inline-flex min-h-11 cursor-pointer items-center text-sm font-medium text-lime underline decoration-lime/40 underline-offset-4"
          >
            Buka deck
          </a>
        </div>
        <div class="site-gutter min-w-0 bg-surface py-8 lg:min-h-[32rem] lg:px-10">
          <PreviewSlider slides={project.slides} labelledBy={titleId} frame="plain" />
        </div>
      </div>
    )
  }

  {
    project.layout === 'split-reverse' && (
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center lg:grid-cols-2">
        <div class="site-gutter order-2 min-w-0 bg-surface py-8 lg:order-1 lg:min-h-[32rem] lg:px-10">
          <PreviewSlider slides={project.slides} labelledBy={titleId} frame="plain" />
        </div>
        <div class="site-gutter order-1 py-4 lg:order-2 lg:py-0">
          <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">{project.kicker}</p>
          <h3 id={titleId} class="mt-4 text-3xl font-semibold tracking-tight break-words md:text-5xl">
            {project.name}
          </h3>
          <p class="mt-5 max-w-md text-base leading-relaxed text-muted">{project.summary}</p>
          <a
            href={deckHref}
            class="mt-8 inline-flex min-h-11 cursor-pointer items-center text-sm font-medium text-lime underline decoration-lime/40 underline-offset-4"
          >
            Buka deck
          </a>
        </div>
      </div>
    )
  }

  {
    project.layout === 'phones' && (
      <div class="site-gutter mx-auto max-w-6xl">
        <div class="max-w-xl min-w-0">
          <p class="text-xs font-semibold tracking-[0.2em] text-muted uppercase">{project.kicker}</p>
          <h3 id={titleId} class="mt-4 text-3xl font-semibold tracking-tight break-words md:text-5xl">
            {project.name}
          </h3>
          <p class="mt-5 text-base leading-relaxed text-muted">{project.summary}</p>
        </div>
        <div class="mt-12 hidden items-end justify-center gap-6 lg:flex">
          {project.slides.map((slide, i) => (
            <div
              class:list={[
                'overflow-hidden rounded-[2rem] border-[10px] border-zinc-900 bg-black shadow-[0_24px_60px_rgba(0,0,0,0.45)]',
                i === 1 ? 'w-[280px] -translate-y-6' : 'w-[230px]',
              ]}
            >
              <Image src={slide.src} alt={slide.alt} widths={[230, 280, 420]} sizes="280px" class="h-auto w-full" />
            </div>
          ))}
        </div>
        <div class="mt-10 lg:hidden">
          <PreviewSlider slides={project.slides} labelledBy={titleId} frame="phone" />
        </div>
        <a
          href={deckHref}
          class="mt-10 inline-flex min-h-11 cursor-pointer items-center text-sm font-medium text-lime underline decoration-lime/40 underline-offset-4"
        >
          Buka deck
        </a>
      </div>
    )
  }

  {
    project.layout === 'cards' && (
      <div class="site-gutter mx-auto max-w-6xl">
        <p class="text-center text-xs font-semibold tracking-[0.2em] text-muted uppercase">{heading}</p>
        <h3 id={titleId} class="mt-4 text-center text-3xl font-semibold tracking-tight break-words md:text-5xl">
          {project.name}
        </h3>
        <p class="mx-auto mt-5 max-w-2xl text-center text-base leading-relaxed text-muted">{project.summary}</p>
        <div class="mt-12 hidden gap-6 md:grid md:grid-cols-2">
          {project.slides.slice(0, 2).map((slide) => (
            <article class="overflow-hidden rounded-xl border border-line bg-elevated">
              <Image src={slide.src} alt={slide.alt} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="h-auto w-full" />
              <p class="px-5 py-4 text-sm text-muted">{slide.alt}</p>
            </article>
          ))}
        </div>
        <div class="mt-10 min-w-0">
          <PreviewSlider slides={project.slides} labelledBy={titleId} frame="plain" />
        </div>
        <div class="mt-8 flex justify-center">
          <a
            href={deckHref}
            class="inline-flex min-h-11 cursor-pointer items-center text-sm font-medium text-lime underline decoration-lime/40 underline-offset-4"
          >
            Buka deck
          </a>
        </div>
      </div>
    )
  }
</section>
