---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Halaman tidak ditemukan';
const description = 'Halaman yang diminta tidak ada pada Situs Portofolio Pemrograman Mobile II.';
const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto flex min-h-dvh max-w-xl flex-col justify-center gap-6 px-6 py-16">
    <p class="text-sm font-medium tracking-[0.18em] text-muted uppercase">404</p>
    <h1 class="text-4xl font-semibold tracking-tight">{title}</h1>
    <p class="text-lg leading-relaxed text-muted">Periksa tautan, atau kembali ke beranda.</p>
    <a
      href={homeHref}
      class="inline-flex min-h-11 w-fit cursor-pointer items-center rounded-lg bg-lime px-4 text-sm font-semibold text-lime-ink"
    >
      Kembali ke beranda
    </a>
  </main>
</BaseLayout>
